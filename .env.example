# Wallet — private key for the SignalFuse receiving wallet.
# This wallet owns the USDC. The sidecar holds signing authority for it.
# Lock this file down (chmod 600) and never commit the real .env.
DIVIGENT_WALLET_PRIVATE_KEY=0xREPLACE_ME

# RPC — Base mainnet. Use Alchemy/Infura/QuickNode/public for higher rate limits.
BASE_RPC_URL=https://mainnet.base.org

# Network — 'base' (mainnet, default) or 'base-sepolia' (testnet).
DIVIGENT_CHAIN=base

# Mainnet contract addresses are bundled in @divigent/sdk@1.0.0 — no overrides
# needed for normal use. These vars only matter for private/test deployments.
# Bundled mainnet (verify against divigent.gitbook.io if anything looks off):
#   router       0xE958A89c2CCa697d4896990685800cc1D5AF2A01
#   oracle       0x3Ba775E8fAE60E72c99dE10C720fC44ab38BF71A
#   feeCollector 0x1a2eF76E6E323D95f836917f812f6D159c3A0960
#   dvUsdc       0x1497f7F3b156e110b1d90BC7F1759F40fb48Ea4F
DIVIGENT_ROUTER_ADDRESS=
DIVIGENT_ORACLE_ADDRESS=
DIVIGENT_FEE_COLLECTOR_ADDRESS=
DIVIGENT_DVUSDC_ADDRESS=

# Sidecar HTTP — listens on localhost only by default. Use 7100+ on macOS:
# port 7000 is owned by Control Center / AirPlay Receiver.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=7100

# Bearer token required on /deposit /withdraw /sweep. Generate with:
#   openssl rand -hex 32
# /health, /balance, /preview/withdraw remain open (read-only).
SIDECAR_API_TOKEN=

# Set to 'true' to wire buyer-side x402 (outbound payments through this wallet).
# SignalFuse is seller-side, so leave 'false' unless you intend to spend x402.
BUYER_SIDE_X402=false

# Idle deposit settings
# Floor of USDC to keep hot in the wallet, NOT swept to yield.
MIN_HOT_USDC=20
# EMA reserve ratio used to size the liquid payment buffer.
RESERVE_RATIO=0.1
# Hard cap on per-payment USDC the x402 hook will act on (buyer-side only).
MAX_PAYMENT_USDC=100
# Slippage tolerance on x402 recall + manual withdraws (basis points).
WITHDRAW_SLIPPAGE_BPS=50
# Seller-side: how often to auto-sweep idle USDC above MIN_HOT_USDC into Divigent.
# Set to 0 to disable the ticker and rely solely on POST /sweep.
SWEEP_INTERVAL_MS=300000

# How often to push a wallet/position snapshot to the Python backend.
# Drives the live numbers on the /divigent yield page.
SNAPSHOT_INTERVAL_MS=60000

# Python backend — sidecar notifies it on lifecycle events for observability.
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TOKEN=

# Logging
LOG_LEVEL=info
